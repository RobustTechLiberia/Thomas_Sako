# -----------------------------------------------------------------------------
# 1847 Liberty — CMS server configuration template
# Copy this file to `server/.env` and replace every `<value>` before starting
# the server. Never commit `server/.env` to version control.
#
#   Windows PowerShell:  Copy-Item server\.env.example server\.env
#   Linux / macOS:       cp server/.env.example server/.env
# -----------------------------------------------------------------------------

# ---- Server ----
PORT=8080
# development | production  (production disables dev-only error details)
NODE_ENV=production
# Public base URL: what the browser bar / emails show for the SITE root.
PUBLIC_URL=https://yourdomain.example
# Client app URL used in notification emails that link to SPA pages
# (podcast/playlist/poll). Same as PUBLIC_URL for a single-unit deploy.
CLIENT_URL=__REPLACE__

# ---- Database (existing db_poll schema) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=__REPLACE__
DB_PASSWORD=__REPLACE__
DB_NAME=db_poll
DB_CONNECTION_LIMIT=10
# Require TLS for the DB connection (Aiven, Oracle Cloud, RDS — TLS-only).
DB_SSL=0
# Optional path to a PEM CA bundle inside the container/host (Aiven ca.pem).
DB_SSL_CA_PATH=
# Keep verification ON unless the host cert chain cannot be validated.
DB_SSL_VERIFY=1

# ---- Auth / JWT ----
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=__REPLACE__
JWT_EXPIRES_IN=24h

# ---- Initial admin (seeded ONLY when the account does not exist) ----
ADMIN_INITIAL_EMAIL=__REPLACE__
ADMIN_INITIAL_PASSWORD=__REPLACE__      # min 8 chars, use a strong one
ADMIN_INITIAL_NAME=Administrator
ADMIN_INITIAL_ROLE=admin
# Set to 1 to RE-APPLY the env password/role/name on every boot instead of
# only on first creation (overwrites changes made from the CMS).
ADMIN_FORCE_RESET=0

# ---- nodemailer (Gmail SMTP example) ----
# EMAIL_USER must be the SMTP login (a real email address), not a display name.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=__REPLACE__
# Gmail App Password (2FA required): https://myaccount.google.com/apppasswords
EMAIL_PASS=__REPLACE__

# Where CMS notifications (new bookings, new content) are emailed.
EMAIL_NOTIFY_TO=__REPLACE__

# ---- YouTube Data API (optional; leave blank to use CMS-managed content) ----
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=__REPLACE__

# ---- Social / platform links ----
YOUTUBE_CHANNEL_URL=https://www.youtube.com/__REPLACE__
FACEBOOK_PAGE_URL=https://facebook.com/__REPLACE__
X_PAGE_URL=https://x.com/__REPLACE__
INSTAGRAM_PAGE_URL=https://instagram.com/__REPLACE__
WHATSAPP_ACCOUNT=https://whatsapp.com/__REPLACE__
TIKTOK_PAGE_URL=https://tiktok.com/__REPLACE__
GMAIL_ACCOUNT=__REPLACE__