{
  "name": "thomas-sako",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sitemap": "node generate-sitemap.js",
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "cd server && nodemon --ignore 'frontend/*' --ignore '*.json' --ignore 'node_modules/*' app.js",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "npm run sitemap && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "flowbite": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-google-charts": "^5.2.1",
    "react-router-dom": "^6.30.4",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "sitemap": "^9.0.1",
    "vite": "^8.2.0"
  }
}
