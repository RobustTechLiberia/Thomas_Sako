{
  "version": 2,
  "builds": [
    {
      "src": "server/app.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "functions": {
    "server/app.cjs": {
      "includeFiles": "certs/ca.pem"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(question|home|db|subscribe|api)(?:/.*)?",
      "dest": "server/app.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
