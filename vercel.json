{
  "version": 2,
  "functions": {
    "server/app.cjs": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(question|home|db|subscribe|api)(/.*)?",
      "dest": "server/app.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
