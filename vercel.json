{
  "version": 2,
  "builds": [
    {
      "src": "server/app.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/question(.*)",
      "dest": "/server/app.cjs"
    },
    {
      "src": "/home(.*)",
      "dest": "/server/app.cjs"
    },
    {
      "src": "/db(.*)",
      "dest": "/server/app.cjs"
    },
    {
      "src": "/subscribe(.*)",
      "dest": "/server/app.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
